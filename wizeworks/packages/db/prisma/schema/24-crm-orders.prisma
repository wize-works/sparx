// CRM — Orders.
//
// The order spine the whole platform agrees on. Commerce will layer a
// catalog (products, variants, inventory) and a checkout flow that PRODUCES
// these rows; it never redefines "what an order is."
//
// State machine: placed → fulfilled → delivered, with cancelled / refunded
// branches available from any non-terminal state. The `status` column
// captures the high-water mark; per-fulfillment / per-payment / per-refund
// detail lives in the child tables (see 25-crm-order-items,
// 26-crm-order-payments, 27-crm-order-fulfillments).
//
// Address snapshots (`shippingAddress`, `billingAddress` JSONB) freeze the
// values at placement time. Editing the customer's address later does NOT
// rewrite past orders — required for audit, tax reporting, and dispute
// resolution.
//
// State transitions emit upstream platform events (`order.created`,
// `order.fulfilled`, `order.delivered`, `order.cancelled`, `order.refunded`)
// that the CRM consumer picks up to populate the activity feed and the
// denormalized customer stats.

model Order {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  customerId  String  @map("customer_id") @db.Uuid
  // Origin site (docs/58 D1) — which property the order was placed on. Nullable:
  // legacy / admin / import / MCP orders may have no site (null = no specific
  // site, shows under "All sites"). App-tier scoping only, never an RLS boundary.
  propertyId  String? @map("property_id") @db.Uuid
  orderNumber String  @map("order_number") @db.VarChar(63)

  status          String  @default("placed") @db.VarChar(20) // placed | fulfilled | delivered | cancelled | refunded
  paymentStatus   String  @default("unpaid") @map("payment_status") @db.VarChar(20) // unpaid | partially_paid | paid | refunded
  // High-level origin bucket. storefront | b2b_portal | admin | import | mcp |
  // marketplace (an external sales channel or sparx.market — docs/106 §4.4).
  channel         String? @db.VarChar(63)
  // Specific origin within the channel. For channel='marketplace', the channel
  // slug: tiktok_shop | etsy | amazon | walmart | ebay | faire | meta |
  // sparx_market (docs/106 §4.4).
  source          String? @db.VarChar(63)
  // Channel/marketplace order linkage (docs/106 §4.4). externalId = the
  // marketplace's own order id (the idempotency key on re-ingest); externalStatus
  // = its native status (mapped to `status` on ingest); channelFeeCents = the
  // marketplace commission so net revenue reconciles. NULL for native orders.
  externalId      String? @map("external_id") @db.VarChar(255)
  externalStatus  String? @map("external_status") @db.VarChar(50)
  channelFeeCents Int?    @map("channel_fee_cents")

  subtotal          Decimal @default(0) @db.Decimal(12, 2)
  taxTotal          Decimal @default(0) @map("tax_total") @db.Decimal(12, 2)
  shippingTotal     Decimal @default(0) @map("shipping_total") @db.Decimal(12, 2)
  discountTotal     Decimal @default(0) @map("discount_total") @db.Decimal(12, 2)
  // Document-level fee pass-through (docs/48 §6) — chiefly the card processing
  // fee. Snapshotted in `appliedSurcharges` ([{name,type,value,basis,paymentMethod,
  // amountCents,label}]) so it's reproducible and reversible proportionally on refund.
  surchargeTotal    Decimal @default(0) @map("surcharge_total") @db.Decimal(12, 2)
  appliedSurcharges Json    @default("[]") @map("applied_surcharges")
  total             Decimal @default(0) @db.Decimal(12, 2)
  amountPaid        Decimal @default(0) @map("amount_paid") @db.Decimal(12, 2)
  refundTotal       Decimal @default(0) @map("refund_total") @db.Decimal(12, 2)
  currency          String  @default("USD") @db.VarChar(3)

  // Frozen at placement time. Shape mirrors CustomerAddress.
  shippingAddress Json? @map("shipping_address")
  billingAddress  Json? @map("billing_address")

  placedAt        DateTime  @map("placed_at") @db.Timestamptz
  // The earliest DAY every line on this order can actually be handed over
  // (issue 026) — the placed date plus the longest notice any product on it
  // asks for. Frozen at placement, because changing a product's notice period
  // later must never silently move a date somebody was already promised. NULL
  // means no line asked for notice, which is not the same as "ready today" and
  // must not render as one.
  readyOn         DateTime? @map("ready_on") @db.Date
  paidAt          DateTime? @map("paid_at") @db.Timestamptz
  fulfilledAt     DateTime? @map("fulfilled_at") @db.Timestamptz
  deliveredAt     DateTime? @map("delivered_at") @db.Timestamptz
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledReason String?   @map("cancelled_reason") @db.VarChar(500)
  refundedAt      DateTime? @map("refunded_at") @db.Timestamptz

  customerNote String? @map("customer_note") @db.Text
  internalNote String? @map("internal_note") @db.Text
  metadata     Json    @default("{}")

  // Marketing attribution (docs/128) — where the WEB traffic that produced this
  // order came from, derived ONCE at checkout by matching the buyer's visitor-day
  // hash to their earliest pageview that day. DISTINCT from `channel`/`source`
  // above (those are the SALES channel: storefront / b2b_portal / marketplace).
  // All nullable: an order with no matching same-day web traffic — staff, B2B,
  // POS, phone, subscription renewal, or a visit on a different day — is normal,
  // not an error, and reports render it as an explicit "unattributed" bucket.
  // No visitor hash is ever stored, only the DERIVED class/host/path, so the
  // consent-free privacy model (docs/128 §2) is preserved. `resolvedAt`
  // distinguishes "looked and found nothing" from "never looked" — a backfill
  // needs it to know which orders it still owes work to. Vocabulary matches
  // SiteAnalyticsEvent.source so reports need no mapping table.
  attributionSource       String?   @map("attribution_source") @db.VarChar(20) // search | direct | social | referral | email
  attributionReferrerHost String?   @map("attribution_referrer_host") @db.VarChar(255) // e.g. "instagram.com"; null for direct
  attributionLandingPath  String?   @map("attribution_landing_path") @db.VarChar(2048) // first path this visitor saw that day
  // The email campaign that produced this order (docs/impl transactional-email Slice 10):
  // copied from the matched first-touch pageview's `campaign` when its source is `email`,
  // so "Revenue by traffic source" can drill Email → per-campaign. Null for every
  // non-email (or unattributed) order. Same value space as SiteAnalyticsEvent.campaign.
  attributionCampaign     String?   @map("attribution_campaign") @db.VarChar(64)
  attributionResolvedAt   DateTime? @map("attribution_resolved_at") @db.Timestamptz

  // Set when this order was created by accepting a BillingDocument (a quote) —
  // the real FK replacing the old Quote.convertedToOrderId / metadata-string
  // pointer. This is the ONE physical column for the relation; BillingDocument's
  // `convertedOrder` (72-invoicing.prisma) is its non-FK reverse side. Prisma
  // requires a 1:1 relation's FK to carry a unique constraint matching exactly
  // its `fields: [...]` — a column-level @unique (like SiteConfig.publishedVersionId)
  // rather than a tenant-scoped composite, since document ids are globally unique.
  convertedFromDocumentId String? @unique @map("converted_from_document_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer              Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Deleting a site must NOT delete its orders (finance / tax history) → SetNull.
  property              Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  convertedFromDocument BillingDocument? @relation("DocumentConvertedToOrder", fields: [convertedFromDocumentId], references: [id], onDelete: SetNull)

  // The invoices raised to ask for the money on this order. Plural because a
  // long job can be billed in stages; a shop that takes payment at checkout
  // never raises one at all. Reverse side of BillingDocument.orderId — NOT the
  // same relation as `convertedFromDocument` above, which points the other way
  // (the quote this order came FROM).
  billingDocuments BillingDocument[] @relation("OrderBillingDocuments")

  items          OrderItem[]
  payments       OrderPayment[]
  refunds        OrderRefund[]
  fulfillments   OrderFulfillment[]
  dealLinks      DealOrder[]
  dropshipOrders DropshipOrder[]

  // Warehouse-side work (docs/146 Phase 4) — the walks that fetched this order
  // and the boxes it went out in.
  pickListLinks    PickListOrder[]
  pickListLines    PickListLine[]
  shipmentPackages ShipmentPackage[]

  @@unique([tenantId, orderNumber], map: "orders_tenant_number_unique")
  @@index([tenantId, customerId, placedAt(sort: Desc)])
  @@index([tenantId, propertyId, placedAt(sort: Desc)])
  @@index([tenantId, status, placedAt(sort: Desc)])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, placedAt(sort: Desc)])
  @@index([tenantId, channel, externalId])
  @@map("orders")
}
